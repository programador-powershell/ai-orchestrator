{
  "name": "ai-orchestrator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "dev:desktop": "pnpm --filter @ai-orchestrator/desktop tauri dev",
    "dev:bootstrapper": "pnpm --filter @ai-orchestrator/bootstrapper tauri dev",
    "build:installer:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-local-installer.ps1",
    "test": "pnpm -r --if-present test && node scripts/test-release-manifests.mjs",
    "test:release": "node scripts/test-release-manifests.mjs"
  }
}
