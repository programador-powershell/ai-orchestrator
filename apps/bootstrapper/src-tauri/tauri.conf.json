{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Orchestrator Setup",
  "version": "0.1.0",
  "identifier": "com.aiorchestrator.bootstrapper",
  "build": {
    "beforeDevCommand": "pnpm.cmd dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm.cmd build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Instalar AI Orchestrator",
      "width": 760,
      "height": 570,
      "minWidth": 720,
      "minHeight": 520,
      "resizable": false,
      "decorations": false,
      "transparent": true,
      "shadow": false,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
