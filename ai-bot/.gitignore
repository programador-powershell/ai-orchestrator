# Dependências e artefatos
node_modules/
dist/
target/
*.tsbuildinfo

# Binário do gateway
/dist/aibotd
/dist/aibotd.exe

# Esquemas gerados pelo tauri-build a cada compilação. São derivados do
# Cargo.toml e das capabilities; versioná-los só produz conflito em toda
# atualização do Tauri, sem ninguém nunca lê-los.
apps/desktop/src-tauri/gen/

# Biblioteca nativa e pesos do roteador local.
#
# NÃO versionar: needle.dll tem alguns MB e o modelo tem 14 — e nenhum dos dois
# é nosso. Eles chegam pelo instalador, e o build padrão (sem `-tags needle`)
# não precisa de nenhum dos dois.
*.dll
*.so
*.dylib
models/
needle.h

# Dados locais do gateway. O `token`, o `master.key` e o `vault.json` são
# SEGREDO de verdade; `catalog.json` guarda referências de chave, não chaves —
# mas guarda também a configuração da estação, que não é do repositório.
.aibot/
token
master.key
vault.json
catalog.json
memory.json
worktrees/

# Chave de assinatura da atualização.
#
# A PRIVADA (`scripts/gerar-chaves.mjs`) mora no cofre da TI e nunca aqui: quem
# a tem publica atualização para todas as estações. Estas linhas existem para o
# caso comum de alguém redirecionar a saída do gerador para um arquivo enquanto
# testa — o commit acidental não pode ser a última defesa, mas é a mais barata.
*.pem
*.key

# Sistema operacional e editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs de execução local (o gateway e o provedor de mentira escrevem aqui
# quando rodados à mão para verificação).
*.log
