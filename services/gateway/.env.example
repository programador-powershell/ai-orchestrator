GATEWAY_BIND=0.0.0.0:8787
DATABASE_URL=postgres://aibot:aibot@localhost:5432/aibot
REDIS_URL=redis://localhost:6379
OIDC_ISSUER=https://login.example.com/realms/ai-bot
OIDC_CLIENT_ID=ai-bot-desktop
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=ai-bot
# Base64 de exatamente 32 bytes. Produza e armazene no secret manager do ambiente.
PROVIDER_MASTER_KEY=
RUST_LOG=ai_bot_gateway=info,tower_http=info
ALLOW_DEV_AUTH=false
# Seed Ed25519 (base64, 32 bytes) que assina a politica do bootstrap. A
# publica correspondente e embarcada no cliente managed. Gere no cofre.
POLICY_SIGNING_KEY=
# Escopo OIDC pedido na autorizacao e no refresh (inclui o escopo da API
# quando registrado, ex.: api://<app-id>/access_as_user).
OIDC_SCOPE=
