GATEWAY_BIND=0.0.0.0:8787
DATABASE_URL=postgres://orchestrator:orchestrator@localhost:5432/orchestrator
REDIS_URL=redis://localhost:6379
OIDC_ISSUER=https://login.example.com/realms/multiplike-ai
OIDC_CLIENT_ID=multiplike-ai-desktop
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=multiplike-ai
# Base64 de exatamente 32 bytes. Produza e armazene no secret manager do ambiente.
PROVIDER_MASTER_KEY=
RUST_LOG=multiplike_ai_gateway=info,tower_http=info
ALLOW_DEV_AUTH=false
# Seed Ed25519 (base64, 32 bytes) que assina a politica do bootstrap. A
# publica correspondente e embarcada no cliente managed. Gere no cofre.
POLICY_SIGNING_KEY=
# Escopo OIDC pedido na autorizacao e no refresh (inclui o escopo da API
# quando registrado, ex.: api://<app-id>/access_as_user).
OIDC_SCOPE=
